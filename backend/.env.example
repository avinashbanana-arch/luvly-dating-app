# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
# Example: postgresql://user:password@localhost:5432/dating_app
DATABASE_URL=postgresql://postgres:password@localhost:5432/dating_app
# Optional but recommended for Neon: its non-pooled connection URL. Railway
# migrations use this directly; if omitted, the migration script derives it
# from a standard Neon `-pooler` DATABASE_URL.
DIRECT_URL=

# ---------- JWT ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# ---------- OTP / Twilio (Phone login for India) ----------
# Create a free trial account at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# If Twilio keys are left blank, the server falls back to a CONSOLE OTP
# (prints the code in the terminal) so you can develop without paying for SMS.

# ---------- Email OTP ----------
# Create an account at https://resend.com and verify a sending domain.
# If blank, email OTPs are printed to the backend terminal.
RESEND_API_KEY=
OTP_FROM_EMAIL=Luvly <otp@yourdomain.com>

# ---------- Razorpay (INR subscriptions) ----------
# https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- RevenueCat (mobile App Store / Play Store subscriptions) ----------
# Public SDK keys go in frontend/.env. This secret key stays only on backend.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# ---------- Cloudinary (profile photo/video storage) ----------
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Firebase Admin (Push notifications) ----------
# Download service account JSON from Firebase console and either:
# 1) Point to the file path, OR
# 2) Paste the JSON as a single-line string here
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
